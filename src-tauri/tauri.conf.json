{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteCraft",
  "version": "0.4.0",
  "identifier": "com.fluxenite.notecraft",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NoteCraft",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#09090B"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'; script-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "dialog": false,
      "endpoints": [
        "https://github.com/fluxeniteab/notecraft/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzQTg4M0MxNEIxQUM1REQKUldUZHhScEx3WU9vTTRDQ3pDNmFKRnE1dzJveFZVYmQvVVhiemNEbXl3cVM4YmozZzc4T0ZBZnAK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "publisher": "Fluxenite",
    "copyright": "Copyright © 2026 Fluxenite. GPL-3.0-only.",
    "shortDescription": "Encrypted local-first notes",
    "longDescription": "NoteCraft is an offline-first Markdown knowledge base with encrypted local profiles, backlinks, tasks, graph and canvas views."
  }
}
